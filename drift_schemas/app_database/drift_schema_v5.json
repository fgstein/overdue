  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL DEFAULT 4284246976, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"parent_id\" INTEGER NULL REFERENCES tasks (id) ON DELETE CASCADE, \"project_id\" INTEGER NULL REFERENCES projects (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"type\" INTEGER NOT NULL DEFAULT 0, \"status\" INTEGER NOT NULL DEFAULT 0, \"priority\" INTEGER NOT NULL DEFAULT 1, \"due_date\" INTEGER NULL, \"due_minute\" INTEGER NULL, \"recurrence\" TEXT NULL, \"recurrence_generated_until\" INTEGER NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"archived_at\" INTEGER NULL, \"day_order\" INTEGER NOT NULL DEFAULT 0, \"after_task_id\" INTEGER NULL REFERENCES tasks (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrences\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"date\" INTEGER NOT NULL, \"due_minute\" INTEGER NULL, \"status\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"archived_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"kind\" INTEGER NOT NULL, \"at_date\" INTEGER NULL, \"at_minute\" INTEGER NULL, \"offset_minutes\" INTEGER NULL, \"repeat_rule\" TEXT NULL, \"at_utc\" INTEGER NULL, \"occurrence_date\" INTEGER NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "scheduled_notifications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scheduled_notifications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"instance_key\" TEXT NOT NULL, \"reminder_id\" INTEGER NOT NULL, \"task_id\" INTEGER NOT NULL, \"occurrence_date\" INTEGER NULL, \"fire_at\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"signature\" TEXT NOT NULL, \"delivered_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "postponements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"postponements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"from_date\" INTEGER NOT NULL, \"to_date\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"archived_at\" INTEGER NULL);"
        }
      ]
    },
